<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.mryrt</groupId>
    <artifactId>airbnb-payment-ra</artifactId>
    <version>1.0</version>
    <packaging>rar</packaging>
    <name>AirBnb Payment Resource Adapter</name>
    <description>JCA Resource Adapter for YooKassa payment gateway</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- API interfaces — bundled in RAR so IronJacamar can load annotated classes -->
        <dependency>
            <groupId>org.mryrt</groupId>
            <artifactId>airbnb-payment-api</artifactId>
            <version>1.0</version>
        </dependency>

        <!-- JCA API — provided by WildFly -->
        <dependency>
            <groupId>jakarta.resource</groupId>
            <artifactId>jakarta.resource-api</artifactId>
            <version>2.1.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- YooKassa SDK — bundled in RAR -->
        <dependency>
            <groupId>com.github.DeelTer</groupId>
            <artifactId>YooKassaSDK</artifactId>
            <version>1.0.5</version>
        </dependency>
        <!-- YooKassaSDK declares these as 'provided', so we bundle them explicitly -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Create the impl JAR before rar:rar so includeJar=true can find it -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>create-impl-jar</id>
                        <phase>prepare-package</phase>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-rar-plugin</artifactId>
                <version>3.0.0</version>
                <configuration>
                    <includeJar>true</includeJar>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
